<Page x:Class="ISIP324Kovalenko_WPF.pages.Form"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Style="{StaticResource SectionPanelStyle}">
                <StackPanel Margin="14">
                    <TextBlock Text="Контактные данные покупателя:" Style="{StaticResource SubHeaderTextStyle}"/>

                    <TextBlock Text="Имя (не менее 2 символов):" Style="{StaticResource NormalTextStyle}"/>
                    <TextBox x:Name="NameTextBox"
                             Style="{StaticResource InputTextBoxStyle}"
                             TextChanged="ContactTextBox_TextChanged"/>

                    <TextBlock Text="Телефон (только цифры, 15 цифр):" Style="{StaticResource NormalTextStyle}"/>
                    <TextBox x:Name="PhoneTextBox"
                             MaxLength="15"
                             Style="{StaticResource InputTextBoxStyle}"
                             TextChanged="ContactTextBox_TextChanged"/>

                    <TextBlock Text="Электронная почта:" Style="{StaticResource NormalTextStyle}"/>
                    <TextBox x:Name="EmailTextBox"
                             Style="{StaticResource InputTextBoxStyle}"
                             TextChanged="ContactTextBox_TextChanged"/>

                    <TextBlock x:Name="ValidationStatusTextBlock"
                               Text="Заполните все поля для активации кнопки заявки."
                               Foreground="#DC2626"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" Style="{StaticResource SectionPanelStyle}">
                <StackPanel Margin="14">
                    <TextBlock Text="Итоговая сводка заказа:" Style="{StaticResource SubHeaderTextStyle}"/>
                    <TextBlock x:Name="FinalSummaryTextBlock"
                               Style="{StaticResource NormalTextStyle}"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="FinalPriceTextBlock"
                               Style="{StaticResource PriceTextStyle}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </StackPanel>
</Page>