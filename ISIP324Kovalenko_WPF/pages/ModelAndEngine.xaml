<Page x:Class="ISIP324Kovalenko_WPF.pages.ModelAndEngine"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>

        <StackPanel Style="{StaticResource SectionPanelStyle}">
            <StackPanel Margin="14">
                <TextBlock Text="Выберите модель автомобиля:" Style="{StaticResource SubHeaderTextStyle}"/>
                <ComboBox x:Name="ModelComboBox"
                          Style="{StaticResource InputComboBoxStyle}"
                          SelectionChanged="ModelComboBox_SelectionChanged"/>
                <TextBlock x:Name="BasePriceTextBlock"
                           Text="Базовая стоимость: 0 ₽"
                           Style="{StaticResource NormalTextStyle}"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Style="{StaticResource SectionPanelStyle}">
            <StackPanel Margin="14">
                <TextBlock Text="Выберите тип двигателя:" Style="{StaticResource SubHeaderTextStyle}"/>
                <ComboBox x:Name="EngineComboBox"
                          Style="{StaticResource InputComboBoxStyle}"
                          SelectionChanged="EngineComboBox_SelectionChanged"/>
                <TextBlock x:Name="EngineSurchargeTextBlock"
                           Text="Доплата за двигатель: 0 ₽"
                           Style="{StaticResource NormalTextStyle}"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Style="{StaticResource SectionPanelStyle}">
            <StackPanel Margin="14">
                <TextBlock x:Name="Step1SummaryTextBlock"
                           Text="Итого за модель с выбранным двигателем: 0 ₽"
                           Style="{StaticResource PriceTextStyle}"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Page>