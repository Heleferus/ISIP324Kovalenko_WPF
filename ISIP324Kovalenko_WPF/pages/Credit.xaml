<Page x:Class="ISIP324Kovalenko_WPF.pages.Credit"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <StackPanel Style="{StaticResource SectionPanelStyle}">
            <StackPanel Margin="14">
                <TextBlock Text="Настройка параметров кредита:" Style="{StaticResource SubHeaderTextStyle}"/>

                <TextBlock x:Name="DownPaymentPercentLabel"
                           Text="Первоначальный взнос: 20%"
                           Style="{StaticResource NormalTextStyle}"
                           FontWeight="SemiBold"/>
                <Slider x:Name="DownPaymentSlider"
                        Minimum="0" Maximum="90"
                        TickFrequency="5" IsSnapToTickEnabled="True"
                        Margin="0,4,0,16"
                        ValueChanged="LoanSliders_ValueChanged"/>

                <TextBlock x:Name="LoanTermLabel"
                           Text="Срок кредита: 36 мес. (от 12 до 96 мес.)"
                           Style="{StaticResource NormalTextStyle}"
                           FontWeight="SemiBold"/>
                <Slider x:Name="LoanTermSlider"
                        Minimum="12" Maximum="96"
                        TickFrequency="6" IsSnapToTickEnabled="True"
                        Margin="0,4,0,8"
                        ValueChanged="LoanSliders_ValueChanged"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Style="{StaticResource SectionPanelStyle}">
            <StackPanel Margin="14">
                <TextBlock Text="Результаты расчёта кредита:" Style="{StaticResource SubHeaderTextStyle}"/>
                <TextBlock x:Name="CarTotalPriceTextBlock" Style="{StaticResource NormalTextStyle}"/>
                <TextBlock x:Name="DownPaymentAmountTextBlock" Style="{StaticResource NormalTextStyle}"/>
                <TextBlock x:Name="LoanAmountTextBlock" Style="{StaticResource NormalTextStyle}"/>
                <TextBlock x:Name="MonthlyPaymentTextBlock" Style="{StaticResource PriceTextStyle}"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Page>