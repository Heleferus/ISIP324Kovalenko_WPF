<Page x:Class="ISIP324Kovalenko_WPF.pages.Cost"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>

        <StackPanel Style="{StaticResource SectionPanelStyle}">
            <StackPanel Margin="14">
                <TextBlock Text="Выбранная комплектация:" Style="{StaticResource SubHeaderTextStyle}"/>
                <TextBlock x:Name="SelectedModelTextBlock" Style="{StaticResource NormalTextStyle}"/>
                <TextBlock x:Name="SelectedEngineTextBlock" Style="{StaticResource NormalTextStyle}"/>
                <TextBlock x:Name="SelectedColorTextBlock" Style="{StaticResource NormalTextStyle}"/>
                <TextBlock Text="Дополнительные опции:" FontWeight="SemiBold" Margin="0,8,0,4" FontSize="14"/>
                <TextBlock x:Name="SelectedOptionsListTextBlock"
                           Style="{StaticResource NormalTextStyle}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Style="{StaticResource SectionPanelStyle}">
            <StackPanel Margin="14">
                <TextBlock Text="Составляющие стоимости автомобиля:" Style="{StaticResource SubHeaderTextStyle}"/>
                <TextBlock x:Name="BreakdownBaseTextBlock" Style="{StaticResource NormalTextStyle}"/>
                <TextBlock x:Name="BreakdownEngineTextBlock" Style="{StaticResource NormalTextStyle}"/>
                <TextBlock x:Name="BreakdownColorTextBlock" Style="{StaticResource NormalTextStyle}"/>
                <TextBlock x:Name="BreakdownOptionsTextBlock" Style="{StaticResource NormalTextStyle}"/>
                <TextBlock x:Name="BreakdownTotalTextBlock" Style="{StaticResource PriceTextStyle}"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Page>
