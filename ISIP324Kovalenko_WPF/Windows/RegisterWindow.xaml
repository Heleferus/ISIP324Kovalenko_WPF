<Window x:Class="ISIP324Kovalenko_WPF.Windows.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ISIP324Kovalenko_WPF.Windows"
        mc:Ignorable="d"
        Title="RegisterWindow" Height="400" Width="400">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
            <TextBlock Text="Регистрация" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Left" />
            <TextBlock Text="Логин" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Left" />
            <TextBox x:Name="LoginTextBox" Margin="5,0,5,10" Padding="2"/>
            <TextBlock Text="ФИО" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Left" />
            <TextBox x:Name="FullNameTextBox" Margin="5,0,5,10" Padding="2"/>
            <TextBlock Text="Пароль" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Left" />
            <PasswordBox x:Name="PasswordBox" Margin="5,0,5,20" Padding="2"/>
            <Button x:Name="RegisterButton" Content="Зарегистрироваться" Width="150" Height="30" Click="RegisterButton_Click"/>
            <Button x:Name="CancelButton" Content="Отмена" Margin="0,10,0,0" Width="100" Height="30" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
