<Page x:Class="ISIP324Kovalenko_WPF.Pages.PersonalPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP324Kovalenko_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PersonalPage">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20" HorizontalAlignment="Center">
            <TextBlock Text="{Binding Login, StringFormat='Логин: {0}'}" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="{Binding Password, StringFormat='Пароль: {0}'}" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="{Binding FullName, StringFormat='Полное имя: {0}'}" FontSize="20" FontWeight="Bold"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Купленные билеты" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
            <ItemsControl x:Name="PurchasedTickets">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{Binding Session.Movie.Title, StringFormat='Фильм: {0}'}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Session.SessionDate, StringFormat='Дата: {0:dd.MM.yyyy}'}"/>
                                <TextBlock Text="{Binding Session.SessionTime, StringFormat='Время: {0}'}"/>
                                <TextBlock Text="{Binding Session.Hall.HallNumber, StringFormat='Зал №{0}'}"/>
                                <TextBlock Text="{Binding SeatNumber, StringFormat='Место: {0}'}"/>
                                <TextBlock Text="{Binding Session.Price, StringFormat='Цена: {0} ₽'}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</Page>
