<Page x:Class="ISIP324Kovalenko_WPF.Pages.Ticket"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP324Kovalenko_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Ticket">

    <Grid>
        <StackPanel Margin="0,0,0,12" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="TicketInfoText" FontSize="20" FontWeight="Bold"/>
            <TextBlock x:Name="TicketPriceText" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"/>
            <Button x:Name="RegisterTicketButton" Content="Потдвердить оформление билета" Width="190" Height="34" Click="RegisterTicketButton_Click"/>
        </StackPanel>
    </Grid>
</Page>
