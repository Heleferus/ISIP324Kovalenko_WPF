<Page x:Class="ISIP324Kovalenko_WPF.Pages.Session"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP324Kovalenko_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Session">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="SessionInfoText" FontSize="20" FontWeight="Bold"/>
            <TextBlock x:Name="SessionPriceText" FontSize="15" Foreground="Gray" Margin="0,4,0,0"/>
        </StackPanel>

       
        <CheckBox Grid.Row="1" x:Name="HideOccupiedCheckBox" Content="Скрыть занятые места" FontSize="14" Margin="0,0,0,12" Checked="HideOccupiedCheckBox_Checked" 
                  Unchecked="HideOccupiedCheckBox_Checked"/>

       
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="SeatsPanel" Orientation="Horizontal"/>
        </ScrollViewer>

        
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,0" VerticalAlignment="Center">
            <Button Content="Назад" Width="90" Height="34" Margin="0,0,16,0" Click="BackButton_Click"/>
            <TextBlock x:Name="SelectedSeatText" Text="Место не выбрано" FontSize="15" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button Content="Оформить билет" Width="150" Height="34" Click="BuyTicketButton_Click"/>
        </StackPanel>
    </Grid>
</Page>
