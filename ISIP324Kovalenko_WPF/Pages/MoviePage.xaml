<Page x:Class="ISIP324Kovalenko_WPF.Pages.MoviePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP324Kovalenko_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MoviePage">

    <Grid>
       <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="250" />
       </Grid.RowDefinitions>
        
       <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
       </Grid.ColumnDefinitions>
        
       <Border Grid.Column="0" Grid.RowSpan="1" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="8" Margin="32,16,32,16" HorizontalAlignment="Center" >
            <Image Source="{Binding PosterUrl}" Stretch="Uniform"/>
       </Border>
        
       <StackPanel Grid.Column="1" Grid.Row="0" Margin="32,16,32,16">
            <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" />
            <TextBlock Text="{Binding Description}" FontSize="16" TextWrapping="Wrap" />
       </StackPanel>
        
       <StackPanel Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" Margin="32,16,32,16" Height="200" Width="Auto">
            <TextBlock Text="Рейтинг: " FontSize="16" FontWeight="Bold" />
            <TextBlock Text="{Binding Rating}" FontSize="16" />
            <TextBlock Text="Дата выхода: " FontSize="16" FontWeight="Bold" />
            <TextBlock Text="{Binding ReleaseDate}" FontSize="16" />
            <TextBlock Text="Возрастное ограничение: " FontSize="16" FontWeight="Bold" />
            <TextBlock Text="{Binding AgeRating}" FontSize="16" />
            <TextBlock Text="Жанр: " FontSize="16" FontWeight="Bold" />
            <TextBlock Text="{Binding Genres}" FontSize="16" />
        </StackPanel>
        <Button Grid.Column="0" Grid.Row="1" Content="Назад" Width="100" Height="30" Margin="32,0,0,16" HorizontalAlignment="Left" VerticalAlignment="Bottom" Click="BackButton_Click" />


        <ListBox Grid.Column="1" Grid.Row="1" x:Name="lstHalls" Margin="32,16,32,16" ItemsSource="{Binding halls}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Зал: " FontSize="16" FontWeight="Bold" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding HallNumber}" FontSize="16" FontWeight="Bold" Margin="0,0,8,0"/>
                        <TextBlock Text="Количество мест: " FontSize="16" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding SeatsCount}" FontSize="16" Margin="0,0,8,0"/>
                        <TextBlock Text="Рейтинг: " FontSize="16" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Rating}" FontSize="16" Margin="0,0,8,0"/>
                        <Button Content="Забронировать" Width="100" Height="30" Click="BookButton_Click"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </Grid>
</Page>
