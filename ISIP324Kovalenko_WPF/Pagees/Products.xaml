<Page x:Class="ISIP324Kovalenko_WPF.Page.Products"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP324Kovalenko_WPF.Page"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Products">

    <Grid>
        <ListBox ScrollViewer.HorizontalScrollBarVisibility="Disabled" x:Name="lstProducts">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            
           <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black" BorderThickness="1" Margin="5">
                        <StackPanel Width="150" Height="235">
                            <Image Source="{Binding ImagePath}" Width="150" Height="150"/>
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="5,0,5,0" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Price}" Margin="5,0,5,0"/>
                            <Button Content="Добавить в корзину" Margin="5" Click="AddToCart_Click"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>

            <ListBox.ItemsSource>
                <Binding Path="products"/>
            </ListBox.ItemsSource>

        </ListBox>
    </Grid>
</Page>
