<Page x:Class="ISIP324Kovalenko_WPF.Page.Order"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP324Kovalenko_WPF.Page"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Order">

    <Grid>
       <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <WrapPanel Grid.Row="0" Margin="10">
            <TextBlock Text="Имя:" VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="txtName" Width="150" Margin="5"/>
            <TextBlock Text="Фамилия:" VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="txtLastName" Width="150" Margin="5"/>
            <TextBlock Text="Email:" VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="txtEmail" Width="180" Margin="5"/>
            <TextBlock Text="Адрес:" VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="txtAddress" Width="180" Margin="5"/>
            <Button x:Name="btnPlaceOrder" Content="Заказать" Click="PlaceOrder_Click" Margin="5"/>
        </WrapPanel>
        <ListBox x:Name="lstOrders" Grid.Row="1" Margin="10">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="5"/>
                        <TextBlock Text="{Binding Surname}" VerticalAlignment="Center" Margin="5"/>
                        <TextBlock Text="{Binding Email}" VerticalAlignment="Center" Margin="5"/>
                        <TextBlock Text="{Binding DeliveryAddress}" VerticalAlignment="Center" Margin="5"/>
                        <TextBlock Text="{Binding TotalPrice}" VerticalAlignment="Center" Margin="5"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>
