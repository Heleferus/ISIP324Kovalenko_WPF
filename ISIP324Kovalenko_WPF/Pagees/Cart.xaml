<Page x:Class="ISIP324Kovalenko_WPF.Page.Cart"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP324Kovalenko_WPF.Page"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Cart">

    <Grid>
      <StackPanel>
            <ListBox x:Name="lstCart" Margin="10">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="5">
                            <Image Source="{Binding Product.ImagePath}" Width="50" Height="50" Margin="5"/>
                            <TextBlock Text="{Binding Product.Name}" VerticalAlignment="Center" Margin="5"/>
                            <TextBlock Text="{Binding Product.Price}" VerticalAlignment="Center" Margin="5"/>
                            <TextBlock Text="{Binding Quantity}" VerticalAlignment="Center" Margin="5"/>
                            <Button Content="Удалить" Click="RemoveFromCart_Click" Margin="5"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Button Content="Оформить заказ" Click="Checkout_Click" Margin="10"/>
      </StackPanel>
    </Grid>
</Page>
